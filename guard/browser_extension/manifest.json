{
  "manifest_version": 3,
  "name": "GIGANG Content Match Sensor",
  "version": "3.8.8",
  "description": "보안 정책에 따른 AI 서비스 이용 및 자료 첨부 관리",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GIGANG 감시 상태",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "policy_tick.js",
        "lifecycle_content.js",
        "image_match.js",
        "image_content.js",
        "transfer_guard.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "112"
}
