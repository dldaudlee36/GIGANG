# ==============================================================================
# GIGANG SecOps - Git Ignore Configuration
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: Never commit API keys)
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json
!.env.example

# IDE & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Presentation & Large Binary Files (Store in Drive/Notion to prevent Git bloat)
*.pptx
*.ppt
*.pdf
*.zip
*.tar.gz
*.7z

# Dynamic Logs & Simulation Artifacts
*.log
!data/raw_logs/sample_*.log
data/generated_logs.json

# Web Temporary Backups
web/*_backup_*

# Streamlit Local Secrets
.streamlit/secrets.toml
