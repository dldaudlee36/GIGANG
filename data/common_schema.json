{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityProjectSchemas",
  "definitions": {
    "NormalizedLog": {
      "type": "object",
      "required": ["id", "timestamp", "source", "event_type", "severity"],
      "properties": {
        "id": { "type": "string", "description": "Unique log identifier" },
        "timestamp": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["auth", "firewall", "server", "db", "endpoint"] },
        "user": { "type": ["string", "null"] },
        "src_ip": { "type": ["string", "null"] },
        "dst_ip": { "type": ["string", "null"] },
        "src_port": { "type": ["integer", "null"] },
        "dst_port": { "type": ["integer", "null"] },
        "protocol": { "type": ["string", "null"] },
        "action": { "type": ["string", "null"], "enum": ["allow", "deny", "login_success", "login_fail", "query", "access", "error"] },
        "event_type": { "type": "string" },
        "details": { "type": "object" },
        "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] }
      }
    },
    "Incident": {
      "type": "object",
      "required": ["incident_id", "title", "severity", "status", "created_at", "correlation_score", "reasons", "attack_timeline", "network_path"],
      "properties": {
        "incident_id": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "status": { "type": "string", "enum": ["OPEN", "INVESTIGATING", "CONTAINED", "RESOLVED"] },
        "created_at": { "type": "string", "format": "date-time" },
        "target_user": { "type": "string" },
        "primary_src_ip": { "type": "string" },
        "correlation_score": { "type": "number" },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criteria": { "type": "string" },
              "score": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "attack_timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "integer" },
              "timestamp": { "type": "string" },
              "source": { "type": "string" },
              "stage": { "type": "string" },
              "description": { "type": "string" },
              "raw_log_id": { "type": "string" }
            }
          }
        },
        "network_path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_node": { "type": "string" },
              "to_node": { "type": "string" },
              "port": { "type": "integer" },
              "protocol": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        },
        "ai_analysis": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "mitre_tactics": { "type": "array", "items": { "type": "string" } },
            "confidence": { "type": "number" },
            "recommended_playbook": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": { "type": "string" },
                  "command": { "type": "string" },
                  "target": { "type": "string" },
                  "status": { "type": "string", "enum": ["PENDING", "EXECUTED", "SKIPPED"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
